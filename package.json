{
  "name": "xuding",
  "version": "0.1.2",
  "description": "续订 — 本地优先的开源桌面订阅管理器",
  "main": "out/main/index.js",
  "author": "ztbytd",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && electron-vite build",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "check": "npm run typecheck && npm test",
    "pack": "npm run build && electron-builder --dir --publish never",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "postinstall": "node node_modules/electron/install.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "antd": "6.6.6",
    "lucide-react": "1.59.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "overrides": {
    "global-agent": "4.1.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ztbytd/xuding.git"
  },
  "bugs": {
    "url": "https://github.com/ztbytd/xuding/issues"
  },
  "homepage": "https://github.com/ztbytd/xuding#readme"
}
